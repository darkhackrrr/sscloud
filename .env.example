# =============================================================================
# ScreenshotCloud - environment variables
#
# Copy this file to `.env.local` for local development:
#     copy .env.example .env.local
#
# NEVER put real secrets in this file, in git, or in any NEXT_PUBLIC_ variable.
# On Vercel, set these under Project Settings -> Environment Variables.
# =============================================================================

# -----------------------------------------------------------------------------
# Vercel Blob storage (REQUIRED)
#
# Create the store in the Vercel dashboard:
#   Storage -> Create Storage -> Blob -> Access: Public -> Connect to Project
#
# Two authentication methods exist. The SDK picks the first one it finds:
#
#   Method A (recommended) - OIDC. When you connect a Blob store to your project
#   Vercel adds BLOB_STORE_ID automatically. VERCEL_OIDC_TOKEN is issued and
#   rotated by Vercel, so you normally do not set it by hand. Use this on Vercel.
#
#   Method B - long-lived read/write token. Use it for local development or if
#   your code runs outside Vercel. Pull it into `.env.local` with `vercel env pull`.
# -----------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=

# Optional: only needed if you are not using OIDC.
BLOB_STORE_ID=

# -----------------------------------------------------------------------------
# Screenshot upload authentication (REQUIRED)
#
# Bearer token required by POST /api/upload. Generate a long random value, for
# example:  [guid]::NewGuid().ToString("N") + [guid]::NewGuid().ToString("N")
# The same value goes into your PowerShell configuration as $UploadKey.
# -----------------------------------------------------------------------------
SCREENSHOT_UPLOAD_KEY=

# -----------------------------------------------------------------------------
# Dashboard / admin authentication (REQUIRED to open /dashboard)
#
# This is deliberately separate from SCREENSHOT_UPLOAD_KEY: the PowerShell
# upload key only grants permission to upload, never to list or delete.
# -----------------------------------------------------------------------------
ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Session signing secret (recommended in production)
#
# Signs the HTTP-only dashboard session cookie with HMAC-SHA256. If left empty
# the server derives a fallback secret from ADMIN_PASSWORD. Set an independent
# random value in production so sessions do not depend on the password.
# Generate one:  [guid]::NewGuid().ToString("N") + [guid]::NewGuid().ToString("N")
# -----------------------------------------------------------------------------
SESSION_SECRET=

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------

# Used for absolute URLs / Open Graph metadata. Example: https://my-site.vercel.app
NEXT_PUBLIC_SITE_URL=
